# Project Management Platform - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Configuration
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_this_secure_password
MONGO_DATABASE=project_management

# Full MongoDB URI (alternative to individual settings)
# DATABASE_URI=mongodb://root:password@mongodb:27017/project_management?authSource=admin
DATABASE_NAME=project_management

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# JWT Secret - MUST be at least 32 characters for security
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_here_at_least_32_characters_long

# Token expiration times
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# From address for outgoing emails
FROM_ADDRESS=noreply@yourdomain.com

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Environment (development, staging, production)
ENVIRONMENT=production

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Gin mode (debug, release, test)
GIN_MODE=release

# Enable debug features (true/false)
DEBUG_MODE=false

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Gmail SMTP Example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Outlook/Hotmail SMTP Example:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password

# Custom SMTP Example (as used in development):
# SMTP_HOST=mail.cock.li
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=username@cock.li
# SMTP_PASS=your_password

# =============================================================================
# PRODUCTION NOTES
# =============================================================================

# 1. Generate secure passwords and secrets
# 2. Use environment-specific values
# 3. Never commit this file with real credentials
# 4. Consider using Docker secrets or external secret management
# 5. Regularly rotate secrets and passwords
# 6. Use HTTPS in production
# 7. Configure proper CORS origins
# 8. Set up monitoring and alerting