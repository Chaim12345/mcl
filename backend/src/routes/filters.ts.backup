import { Router, Request, Response } from 'express';
import { authenticateToken } from '../middleware/auth.js';
import {
  filterBoardItems,
  saveFilter,
  getSavedFilters,
  deleteFilter,
  createSimpleFilter,
  validateFilter,
  FilterGroup,
  FilterDefinition
} from '../services/filterService.js';
import {
  saveView,
  getSavedViews,
  getDefaultView,
  deleteView,
  shareView
} from '../services/viewService.js';
import {
  validateView,
  setDefaultView,
  copyView,
  ViewPermissionLevel,
  setViewPermission,
  getViewPermissions,
  applySorting,
  SearchOptions,
  refreshSearchIndex,
  getTrendingSearchTerms,
  getRelatedSearchTerms,
  getViewTemplates,
  createViewTemplate,
  deleteViewTemplate,
  createViewFromTemplate
} from './filters-stubs.js';
import {
  searchBoardItems,
  getSearchHistory,
  getSearchSuggestions,
  clearSearchHistory
} from '../services/searchService.js';
import { Priority, Status } from '../models/types.js';

const router = Router();

// Helper function to validate authenticated user
function validateUser(req: Request, res: Response): req is Request & { user: { id: string } } {
  if (!req.user) {
    res.status(401).json({ error: 'User not authenticated' });
    return false;
  }
  return true;
}

// ===== FILTER ROUTES =====

/**
 * POST /api/boards/:boardId/filter
 * Filter items in a board using complex criteria
 */
router.post('/boards/:boardId/filter', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const { filter, sorts } = req.body;
    
    // Validate filter
    if (!filter) {
      res.status(400).json({ error: 'Filter is required' });
      return;
    }
    
    const validation = validateFilter(filter);
    if (!validation.isValid) {
      res.status(400).json({ error: validation.errors.join(', ') });
      return;
    }
    
    if (!boardId) {
      res.status(400).json({ error: 'Board ID is required' });
      return;
    }
    
    const items = await filterBoardItems(boardId, filter, userId, sorts);
    res.json(items);
  } catch (error) {
    console.error('Error filtering items:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to filter items' });
  }
});

/**
 * POST /api/boards/:boardId/simple-filter
 * Filter items using simple criteria
 */
router.post('/boards/:boardId/simple-filter', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const { 
      columnId, 
      status, 
      priority, 
      dueDateFrom, 
      dueDateTo,
      searchTerm,
      sorts
    } = req.body;
    
    // Create a simple filter from the criteria
    const filter = createSimpleFilter({
      columnId,
      status: status as Status,
      priority: priority as Priority,
      dueDateFrom: dueDateFrom ? new Date(dueDateFrom) : undefined,
      dueDateTo: dueDateTo ? new Date(dueDateTo) : undefined,
      searchTerm
    });
    
    if (!boardId) {
      res.status(400).json({ error: 'Board ID is required' });
      return;
    }
    
    const items = await filterBoardItems(boardId, filter, userId, sorts);
    res.json(items);
  } catch (error) {
    console.error('Error filtering items:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to filter items' });
  }
});

/**
 * GET /api/boards/:boardId/saved-filters
 * Get all saved filters for a board
 */
router.get('/boards/:boardId/saved-filters', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    if (!boardId) {
      res.status(400).json({ error: 'Board ID is required' });
      return;
    }

    const filters = await getSavedFilters(boardId, userId);
    res.json(filters);
  } catch (error) {
    console.error('Error fetching saved filters:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to fetch saved filters' });
  }
});

/**
 * POST /api/boards/:boardId/saved-filters
 * Save a filter for a board
 */
router.post('/boards/:boardId/saved-filters', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const filterData: Omit<FilterDefinition, 'createdBy'> = req.body;
    
    // Validate filter
    if (!filterData.name || filterData.name.trim().length === 0) {
      res.status(400).json({ error: 'Filter name is required' });
      return;
    }
    
    if (!filterData.filter) {
      res.status(400).json({ error: 'Filter definition is required' });
      return;
    }
    
    const validation = validateFilter(filterData.filter);
    if (!validation.isValid) {
      res.status(400).json({ error: validation.errors.join(', ') });
      return;
    }
    
    const filter = await saveFilter({
      ...filterData,
      boardId,
      createdBy: userId
    }, userId);
    
    res.status(201).json(filter);
  } catch (error) {
    console.error('Error saving filter:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to save filter' });
  }
});

/**
 * DELETE /api/saved-filters/:filterId
 * Delete a saved filter
 */
router.delete('/saved-filters/:filterId', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { filterId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const deleted = await deleteFilter(filterId, userId);
    if (!deleted) {
      res.status(404).json({ error: 'Filter not found' });
      return;
    }
    
    res.status(204).send();
  } catch (error) {
    console.error('Error deleting filter:', error);
    if (error instanceof Error) {
      if (error.message.includes('access')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to delete filter' });
  }
});

// ===== VIEW ROUTES =====

/**
 * GET /api/boards/:boardId/views
 * Get all saved views for a board
 */
router.get('/boards/:boardId/views', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    const { includeShared, includeGlobal, includeTemplates } = req.query;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const options = {
      includeShared: includeShared !== 'false',
      includeGlobal: includeGlobal !== 'false',
      includeTemplates: includeTemplates === 'true'
    };
    
    const views = await getSavedViews(boardId, userId, options);
    res.json(views);
  } catch (error) {
    console.error('Error fetching saved views:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to fetch saved views' });
  }
});

/**
 * GET /api/boards/:boardId/default-view
 * Get the default view for a board
 */
router.get('/boards/:boardId/default-view', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    const { useGlobal } = req.query;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const options = {
      useGlobal: useGlobal !== 'false'
    };
    
    const view = await getDefaultView(boardId, userId, options);
    if (!view) {
      res.status(404).json({ error: 'No default view found' });
      return;
    }
    
    res.json(view);
  } catch (error) {
    console.error('Error fetching default view:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to fetch default view' });
  }
});

/**
 * POST /api/boards/:boardId/views
 * Save a view for a board
 */
router.post('/boards/:boardId/views', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const viewData = req.body;
    
    // Validate view
    const validation = validateView(viewData);
    if (!validation.isValid) {
      res.status(400).json({ error: validation.errors.join(', ') });
      return;
    }
    
    // If filter is provided, validate it
    if (viewData.filter) {
      const filterValidation = validateFilter(viewData.filter);
      if (!filterValidation.isValid) {
        res.status(400).json({ error: filterValidation.errors.join(', ') });
        return;
      }
    }
    
    const view = await saveView({
      ...viewData,
      boardId,
      createdBy: userId
    }, userId);
    
    res.status(201).json(view);
  } catch (error) {
    console.error('Error saving view:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to save view' });
  }
});

/**
 * DELETE /api/views/:viewId
 * Delete a saved view
 */
router.delete('/views/:viewId', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { viewId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const deleted = await deleteView(viewId, userId);
    if (!deleted) {
      res.status(404).json({ error: 'View not found' });
      return;
    }
    
    res.status(204).send();
  } catch (error) {
    console.error('Error deleting view:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('permission')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to delete view' });
  }
});

/**
 * PUT /api/views/:viewId/share
 * Share or unshare a view
 */
router.put('/views/:viewId/share', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { viewId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const { isShared } = req.body;
    
    if (typeof isShared !== 'boolean') {
      res.status(400).json({ error: 'isShared must be a boolean' });
      return;
    }
    
    const view = await shareView(viewId, isShared, userId);
    if (!view) {
      res.status(404).json({ error: 'View not found' });
      return;
    }
    
    res.json(view);
  } catch (error) {
    console.error('Error sharing view:', error);
    if (error instanceof Error) {
      if (error.message.includes('access')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to share view' });
  }
});

/**
 * PUT /api/boards/:boardId/default-view/:viewId
 * Set a view as the default for a board
 */
router.put('/boards/:boardId/default-view/:viewId', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId, viewId } = req.params;
    const { isGlobal } = req.body;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const options = {
      isGlobal: isGlobal === true
    };
    
    const success = await setDefaultView(viewId, boardId, userId, options);
    if (!success) {
      res.status(404).json({ error: 'View not found or does not belong to the board' });
      return;
    }
    
    res.json({ success: true });
  } catch (error) {
    console.error('Error setting default view:', error);
    if (error instanceof Error) {
      if (error.message.includes('access')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to set default view' });
  }
});

/**
 * POST /api/views/:viewId/copy
 * Copy a view
 */
router.post('/views/:viewId/copy', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { viewId } = req.params;
    const { name } = req.body;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    if (!name || name.trim().length === 0) {
      res.status(400).json({ error: 'View name is required' });
      return;
    }
    
    const view = await copyView(viewId, name, userId);
    if (!view) {
      res.status(404).json({ error: 'View not found' });
      return;
    }
    
    res.status(201).json(view);
  } catch (error) {
    console.error('Error copying view:', error);
    if (error instanceof Error) {
      if (error.message.includes('access')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to copy view' });
  }
});

/**
 * PUT /api/views/:viewId/permissions/:userId
 * Set view permissions for a user
 */
router.put('/views/:viewId/permissions/:targetUserId', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { viewId, targetUserId } = req.params;
    const { permissionLevel } = req.body;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    if (!permissionLevel || !Object.values(ViewPermissionLevel).includes(permissionLevel as ViewPermissionLevel)) {
      res.status(400).json({ error: `Permission level must be one of: ${Object.values(ViewPermissionLevel).join(', ')}` });
      return;
    }
    
    const success = await setViewPermission(viewId, targetUserId, permissionLevel as ViewPermissionLevel, userId);
    if (!success) {
      res.status(404).json({ error: 'View not found' });
      return;
    }
    
    res.json({ success: true });
  } catch (error) {
    console.error('Error setting view permission:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('permission')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to set view permission' });
  }
});

/**
 * GET /api/views/:viewId/permissions
 * Get view permissions
 */
router.get('/views/:viewId/permissions', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { viewId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const permissions = await getViewPermissions(viewId, userId);
    res.json(permissions);
  } catch (error) {
    console.error('Error getting view permissions:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('permission')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to get view permissions' });
  }
});

/**
 * POST /api/boards/:boardId/sort
 * Apply multi-column sorting to a board
 */
router.post('/boards/:boardId/sort', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    const { sorts, limit, offset } = req.body;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    if (!Array.isArray(sorts)) {
      res.status(400).json({ error: 'Sorts must be an array' });
      return;
    }
    
    const options = {
      limit: limit ? parseInt(limit as string, 10) : undefined,
      offset: offset ? parseInt(offset as string, 10) : undefined
    };
    
    const items = await applySorting(boardId, sorts, userId, options);
    res.json(items);
  } catch (error) {
    console.error('Error applying sorting:', error);
    if (error instanceof Error) {
      if (error.message.includes('access')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to apply sorting' });
  }
});

// ===== SEARCH ROUTES =====

/**
 * GET /api/boards/:boardId/search
 * Search items in a board
 */
router.get('/boards/:boardId/search', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId } = req.params;
    const { 
      q, 
      limit, 
      offset, 
      saveHistory, 
      includeFieldValues,
      searchInColumns,
      minRelevance,
      highlightResults,
      sortBy,
      sortDirection
    } = req.query;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    if (!q || typeof q !== 'string') {
      res.status(400).json({ error: 'Search query is required' });
      return;
    }
    
    const options: SearchOptions = {
      limit: limit ? parseInt(limit as string, 10) : undefined,
      offset: offset ? parseInt(offset as string, 10) : undefined,
      saveHistory: saveHistory === 'true',
      includeFieldValues: includeFieldValues === 'true',
      searchInColumns: searchInColumns ? (searchInColumns as string).split(',') : undefined,
      minRelevance: minRelevance ? parseFloat(minRelevance as string) : undefined,
      highlightResults: highlightResults === 'true',
      sortBy: sortBy as 'relevance' | 'created' | 'updated' | undefined,
      sortDirection: sortDirection as 'asc' | 'desc' | undefined
    };
    
    const results = await searchBoardItems(boardId, q, userId, options);
    res.json(results);
  } catch (error) {
    console.error('Error searching items:', error);
    if (error instanceof Error) {
      if (error.message.includes('access') || error.message.includes('not found')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to search items' });
  }
});

/**
 * GET /api/search/history
 * Get search history for the current user
 */
router.get('/search/history', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const { limit, boardId, offset } = req.query;
    
    const options = {
      limit: limit ? parseInt(limit as string, 10) : undefined,
      boardId: boardId as string || null,
      offset: offset ? parseInt(offset as string, 10) : undefined
    };
    
    const history = await getSearchHistory(userId, options);
    
    res.json(history);
  } catch (error) {
    console.error('Error fetching search history:', error);
    res.status(500).json({ error: 'Failed to fetch search history' });
  }
});

/**
 * DELETE /api/search/history
 * Clear search history for the current user
 */
router.delete('/search/history', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    await clearSearchHistory(userId);
    res.status(204).send();
  } catch (error) {
    console.error('Error clearing search history:', error);
    res.status(500).json({ error: 'Failed to clear search history' });
  }
});

/**
 * GET /api/search/suggestions
 * Get search suggestions based on history and popular searches
 */
router.get('/search/suggestions', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const { q, boardId, limit, includeGenerated } = req.query;
    
    if (!q || typeof q !== 'string') {
      res.status(400).json({ error: 'Search prefix is required' });
      return;
    }
    
    const options = {
      boardId: boardId as string || null,
      limit: limit ? parseInt(limit as string, 10) : undefined,
      includeGenerated: includeGenerated === 'true'
    };
    
    const suggestions = await getSearchSuggestions(userId, q, options);
    
    res.json(suggestions);
  } catch (error) {
    console.error('Error fetching search suggestions:', error);
    res.status(500).json({ error: 'Failed to fetch search suggestions' });
  }
});

