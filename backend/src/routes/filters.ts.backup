export default router;/**
 
* GET /api/view-templates
 * Get all view templates
 */
router.get('/view-templates', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    if (!validateUser(req, res)) return;
    
    const { category, createdBy } = req.query;
    
    const options = {
      category: category as string,
      createdBy: createdBy as string
    };
    
    const templates = await getViewTemplates(options);
    res.json(templates);
  } catch (error) {
    console.error('Error fetching view templates:', error);
    res.status(500).json({ error: 'Failed to fetch view templates' });
  }
});

/**
 * POST /api/view-templates
 * Create a view template
 */
router.post('/view-templates', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    const templateData = req.body;
    
    // Validate template
    if (!templateData.name || templateData.name.trim().length === 0) {
      res.status(400).json({ error: 'Template name is required' });
      return;
    }
    
    // If filter is provided, validate it
    if (templateData.filter) {
      const validation = validateFilter(templateData.filter);
      if (!validation.isValid) {
        res.status(400).json({ error: validation.errors.join(', ') });
        return;
      }
    }
    
    const template = await createViewTemplate({
      ...templateData,
      createdBy: userId
    }, userId);
    
    res.status(201).json(template);
  } catch (error) {
    console.error('Error creating view template:', error);
    res.status(500).json({ error: 'Failed to create view template' });
  }
});

/**
 * DELETE /api/view-templates/:templateId
 * Delete a view template
 */
router.delete('/view-templates/:templateId', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { templateId } = req.params;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    const deleted = await deleteViewTemplate(templateId, userId);
    if (!deleted) {
      res.status(404).json({ error: 'Template not found' });
      return;
    }
    
    res.status(204).send();
  } catch (error) {
    console.error('Error deleting view template:', error);
    if (error instanceof Error) {
      if (error.message.includes('creator')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to delete view template' });
  }
});

/**
 * POST /api/boards/:boardId/views/from-template/:templateId
 * Create a view from a template
 */
router.post('/boards/:boardId/views/from-template/:templateId', authenticateToken, async (req: Request, res: Response): Promise<void> => {
  try {
    const { boardId, templateId } = req.params;
    const { name } = req.body;
    
    if (!validateUser(req, res)) return;
    
    const userId = req.user.id;
    
    if (!name || name.trim().length === 0) {
      res.status(400).json({ error: 'View name is required' });
      return;
    }
    
    const view = await createViewFromTemplate(templateId, boardId, name, userId);
    if (!view) {
      res.status(404).json({ error: 'Template not found' });
      return;
    }
    
    res.status(201).json(view);
  } catch (error) {
    console.error('Error creating view from template:', error);
    if (error instanceof Error) {
      if (error.message.includes('access')) {
        res.status(403).json({ error: error.message });
        return;
      }
    }
    res.status(500).json({ error: 'Failed to create view from template' });
  }
});