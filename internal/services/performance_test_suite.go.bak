			maxTime = opDuration
		}
	}
	
	totalTime := time.Since(start)
	averageTime := totalTime / iterations
	
	return BenchmarkResult{
		Name:        "item_get",
		Iterations:  iterations,
		TotalTime:   totalTime,
		AverageTime: averageTime,
		MinTime:     minTime,
		MaxTime:     maxTime,
	}
}

func (pts *PerformanceTestSuite) BenchmarkItemUpdate(ctx context.Context) BenchmarkResult {
	const iterations = 1000
	
	// Create test item
	boardID := primitive.NewObjectID()
	item := &Item{
		ID:      primitive.NewObjectID(),
		BoardID: boardID,
		Title:   "Test Item",
		Content: "Test content",
		Position: 1000,
		CreatedBy: primitive.NewObjectID(),
	}
	
	createdItem, err := pts.itemService.CreateItem(ctx, item)
	if err != nil {
		log.Printf("Failed to create test item: %v", err)
		return BenchmarkResult{
			Name: "item_update",
			Iterations: 0,
		}
	}
	
	start := time.Now()
	var minTime, maxTime time.Duration
	minTime = time.Hour
	
	for i := 0; i < iterations; i++ {
		opStart := time.Now()
		update := map[string]interface{}{
			"title": fmt.Sprintf("Updated Item %d", i),
			"content": fmt.Sprintf("Updated content %d", i),
		}
		_, err := pts.itemService.UpdateItem(ctx, createdItem.ID.Hex(), update)
		opDuration := time.Since(opStart)
		
		if err != nil {
			continue
		}
		
		if opDuration < minTime {
			minTime = opDuration
		}
		if opDuration > maxTime {
			maxTime = opDuration
		}
	}
	
	totalTime := time.Since(start)
	averageTime := totalTime / iterations
	
	return BenchmarkResult{
		Name:        "item_update",
		Iterations:  iterations,
		TotalTime:   totalTime,
		AverageTime: averageTime,
		MinTime:     minTime,
		MaxTime:     maxTime,
	}
}

func (pts *PerformanceTestSuite) BenchmarkItemSearch(ctx context.Context) BenchmarkResult {
	const iterations = 1000
	
	// Create test items
	boardID := primitive.NewObjectID()
	userID := primitive.NewObjectID()
	
	for i := 0; i < 100; i++ {
		item := &Item{
			ID:      primitive.NewObjectID(),
			BoardID: boardID,
			Title:   fmt.Sprintf("Search Test Item %d", i),
			Content: fmt.Sprintf("Content for search item %d", i),
			Position: float64(i * 1000),
			CreatedBy: userID,
		}
		pts.itemService.CreateItem(ctx, item)
	}
	
	start := time.Now()
	var minTime, maxTime time.Duration
	minTime = time.Hour
	
	for i := 0; i < iterations; i++ {
		opStart := time.Now()
		filters := map[string]interface{}{
			"board_id": boardID.Hex(),
			"title":    fmt.Sprintf("Search Test Item %d", i%100),
		}
		_, err := pts.itemService.SearchItems(ctx, filters)
		opDuration := time.Since(opStart)
		
		if err != nil {
			continue
		}
		
		if opDuration < minTime {
			minTime = opDuration
		}
		if opDuration > maxTime {
			maxTime = opDuration
		}
	}
	
	totalTime := time.Since(start)
	averageTime := totalTime / iterations
	
	return BenchmarkResult{
		Name:        "item_search",
		Iterations:  iterations,
		TotalTime:   totalTime,
		AverageTime: averageTime,
		MinTime:     minTime,
		MaxTime:     maxTime,
	}
}

