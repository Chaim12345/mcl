func (pts *PerformanceTestSuite) BenchmarkItemCreate(ctx context.Context) BenchmarkResult {
	const iterations = 1000
	
	// Create test board
	boardID := primitive.NewObjectID()
	userID := primitive.NewObjectID()
	
	start := time.Now()
	var minTime, maxTime time.Duration
	minTime = time.Hour
	
	for i := 0; i < iterations; i++ {
		opStart := time.Now()
		item := &Item{
			ID:      primitive.NewObjectID(),
			BoardID: boardID,
			Title:   fmt.Sprintf("Test Item %d", i),
			Content: fmt.Sprintf("Test content for item %d", i),
			Position: float64(i * 1000),
			CreatedBy: userID,
			Fields: map[string]interface{}{
				"status": "todo",
				"priority": "medium",
			},
		}
		
		_, err := pts.itemService.CreateItem(ctx, item)
		opDuration := time.Since(opStart)
		
		if err != nil {
			continue
		}
		
		if opDuration < minTime {
			minTime = opDuration
		}
		if opDuration > maxTime {
			maxTime = opDuration
		}
	}
	
	totalTime := time.Since(start)
	averageTime := totalTime / iterations
	
	return BenchmarkResult{
		Name:        "item_create",
		Iterations:  iterations,
		TotalTime:   totalTime,
		AverageTime: averageTime,
		MinTime:     minTime,
		MaxTime:     maxTime,
	}
}

