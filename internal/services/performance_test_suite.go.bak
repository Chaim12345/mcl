func (pts *PerformanceTestSuite) RunLoadTest(ctx context.Context, testName string, numUsers, requestsPerUser int, targetFunc func(context.Context) error) LoadTestResult {
	var wg sync.WaitGroup
	results := make(chan LoadTestResult, numUsers)
	errors := make(chan error, numUsers*requestsPerUser)
	
	start := time.Now()
	
	// Launch concurrent users
	for i := 0; i < numUsers; i++ {
		wg.Add(1)
		go func(userID int) {
			defer wg.Done()
			
			var userSuccess, userErrors int
			userStart := time.Now()
			var latencies []time.Duration
			
			for j := 0; j < requestsPerUser; j++ {
				reqStart := time.Now()
				err := targetFunc(ctx)
				reqDuration := time.Since(reqStart)
				
				latencies = append(latencies, reqDuration)
				if err != nil {
					userErrors++
					errors <- err
				} else {
					userSuccess++
				}
			}
			
			// Calculate percentiles
			sortLatencies(latencies)
			
			userTime := time.Since(userStart)
			userResult := LoadTestResult{
				Name:           fmt.Sprintf("%s_user_%d", testName, userID),
				TotalRequests:  requestsPerUser,
				FailedRequests: userErrors,
				Duration:       userTime,
				Throughput:     float64(requestsPerUser) / userTime.Seconds(),
				AvgLatency:     userTime / time.Duration(requestsPerUser),
				P95Latency:     latencies[int(float64(len(latencies))*0.95)],
				P99Latency:     latencies[int(float64(len(latencies))*0.99)],
				MaxLatency:     latencies[len(latencies)-1],
			}
			
			results <- userResult
		}(i)
	}
	
	wg.Wait()
	close(results)
	close(errors)
	
	// Aggregate results
	var totalRequests, totalErrors, totalUsers int
	var totalTime time.Duration
	
	for result := range results {
		totalRequests += result.TotalRequests
		totalErrors += result.FailedRequests
		totalUsers++
		if result.Duration > totalTime {
			totalTime = result.Duration
		}
	}
	
	return LoadTestResult{
		Name:           testName,
		TotalRequests:  totalRequests,
		FailedRequests: totalErrors,
		Duration:       time.Since(start),
		Throughput:     float64(totalRequests) / time.Since(start).Seconds(),
	}
}

func sortLatencies(latencies []time.Duration) {
	// Simple bubble sort for small datasets
	for i := 0; i < len(latencies)-1; i++ {
		for j := 0; j < len(latencies)-i-1; j++ {
			if latencies[j] > latencies[j+1] {
				latencies[j], latencies[j+1] = latencies[j+1], latencies[j]
			}
		}
	}
}

func (pts *PerformanceTestSuite) GenerateReport(results map[string]BenchmarkResult) string {
	report := "Performance Test Suite Report\n"
	report += "=============================\n\n"
	
	for name, result := range results {
		report += fmt.Sprintf("%s:\n", name)
		report += fmt.Sprintf("  Iterations: %d\n", result.Iterations)
		report += fmt.Sprintf("  Total Time: %v\n", result.TotalTime)
		report += fmt.Sprintf("  Average Time: %v\n", result.AverageTime)
		report += fmt.Sprintf("  Min Time: %v\n", result.MinTime)
		report += fmt.Sprintf("  Max Time: %v\n", result.MaxTime)
		report += fmt.Sprintf("  Average Throughput: %.2f ops/sec\n\n", float64(result.Iterations)/result.TotalTime.Seconds())
	}
	
	return report
}