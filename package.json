{
  "name": "project-management-platform",
  "version": "1.0.0",
  "description": "A modern project management platform similar to Monday.com",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "go run ./cmd/server",
    "dev:setup": "node scripts/dev-setup.js",
    "build": "npm run build:frontend && go build -o bin/server ./cmd/server",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "go build -o bin/server ./cmd/server",
    "test": "go test ./... && npm run test --workspace=frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "go test ./...",
    "lint": "npm run lint --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up",
    "docker:build": "docker-compose -f docker-compose.prod.yml build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
